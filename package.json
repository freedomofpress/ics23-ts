{
  "name": "@freedomofpress/ics23",
  "version": "0.3.0",
  "description": "Merkle proof verification library (ICS23)",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freedomofpress/ics23-ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Giulio B",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "proto:gen": "npx buf generate buf.build/cosmos/ics23",
    "lint": "eslint .",
    "test": "vitest run",
    "test:playwright": "vitest run --config vite.config.playwright.ts",
    "coverage": "vitest run --coverage",
    "prebuild": "npm run proto:gen",
    "build": "tsc",
    "format": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vite-node": "^5.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@freedomofpress/crypto-browser": "^0.3.0"
  }
}
